{
  "name": "recipes",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "The Eat / Yeet recipe archive: a prerendered TanStack Start site.",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && vite dev",
    "build": "npm run content && vite build && node scripts/build-seo.mjs",
    "preview": "vite preview",
    "test": "npm run build && node test/verify.mjs && node test/interact.mjs",
    "shots": "npm run build && node test/shots.mjs",
    "parity": "npm run build && node test/parity.mjs",
    "convert": "node scripts/convert-fixtures.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.163.3",
    "@tanstack/react-start": "^1.163.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^14.1.3",
    "nitro": "3.0.1-alpha.2",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1"
  }
}
