{
  "name": "@yeet/recipe-blog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "description": "Multi-app prerendered recipe blogs built with TanStack Start.",
  "imports": {
    "#site-config": "./site.config.mjs"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "pnpm run content && vite dev",
    "build": "pnpm run content && HOST=127.0.0.1 vite build && node scripts/copy-public.mjs && node scripts/check-classes.mjs && pnpm run boundaries && pnpm run typecheck:ts && node scripts/prerender.mjs && node scripts/build-seo.mjs",
    "preview": "HOST=127.0.0.1 vite preview",
    "test": "pnpm run test:unit && pnpm run build && node scripts/check-classes.test.mjs && node scripts/verify-build.test.mjs && node test/seo-pages.test.mjs && node packages/l8/web/src/routes/interact.test.mjs && node 'packages/l8/web/src/routes/recipes/$slug/recipe-pages.test.mjs' && pnpm run test:storybook",
    "test:unit": "node --test packages/l8/web/src/lib/seo.test.ts packages/l4/content-build/src/parse.test.mjs scripts/deploy-manifest.test.mjs",
    "test:seo": "pnpm run build && node test/seo-pages.test.mjs",
    "test:a11y": "pnpm run build && node packages/l8/web/src/routes/accessibility.test.mjs",
    "test:lighthouse": "pnpm run build && node packages/l8/web/src/routes/lighthouse.test.mjs",
    "shots": "pnpm run build && node test/shots.mjs",
    "parity": "pnpm run build && node test/parity.mjs",
    "storybook": "pnpm run content && storybook dev -c packages/l8/web/.storybook -p 6006 --host 127.0.0.1",
    "build-storybook": "pnpm run content && storybook build -c packages/l8/web/.storybook -o storybook-static",
    "test:storybook": "pnpm run build-storybook",
    "test:recipe-pages": "pnpm run build && node 'packages/l8/web/src/routes/recipes/$slug/recipe-pages.test.mjs'",
    "convert": "node scripts/convert-fixtures.mjs",
    "classes": "node scripts/check-classes.mjs",
    "boundaries": "node scripts/check-layer-imports.mjs",
    "routes": "node scripts/generate-routes.mjs",
    "serve": "node scripts/serve.mjs",
    "deploy": "node scripts/deploy.mjs",
    "verify:prod": "node test/verify-prod.mjs",
    "typecheck": "pnpm run content && pnpm run routes && pnpm run boundaries && pnpm run typecheck:ts",
    "typecheck:ts": "tsc -b --pretty false",
    "nx": "nx"
  },
  "dependencies": {
    "@eat-yeet/l0-foundation": "workspace:*",
    "@eat-yeet/l1-api-model": "workspace:*",
    "@eat-yeet/l1-recipe-model": "workspace:*",
    "@eat-yeet/l2-recipe-domain": "workspace:*",
    "@eat-yeet/l3-api-contract": "workspace:*",
    "@eat-yeet/l3-api-query": "workspace:*",
    "@eat-yeet/l3-api-static": "workspace:*",
    "@eat-yeet/l4-content-model": "workspace:*",
    "@eat-yeet/l4-content-build": "workspace:*",
    "@eat-yeet/l5-ui-primitives": "workspace:*",
    "@eat-yeet/l6-ui-catalog": "workspace:*",
    "@eat-yeet/l6-ui-content-blocks": "workspace:*",
    "@eat-yeet/l6-ui-shell": "workspace:*",
    "@eat-yeet/l7-home": "workspace:*",
    "@eat-yeet/l7-recipes": "workspace:*",
    "@eat-yeet/l7-search": "workspace:*",
    "@tanstack/react-router": "^1.163.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-start": "^1.163.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "1.167.30",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "chrome-launcher": "^1.2.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.1",
    "lighthouse": "^13.4.1",
    "marked": "^14.1.3",
    "nitro": "^3.0.260610-beta",
    "nx": "^23.1.1",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "shadcn": "^4.19.0",
    "storybook": "^10.5.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.1"
  }
}
