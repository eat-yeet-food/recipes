{
  "name": "@yeet/recipe-blog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "description": "Git-driven Next.js and Payload recipe applications with local Cloudflare emulation.",
  "imports": {
    "#site-config": "./site.config.mjs"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "node scripts/prepare-next.mjs && node scripts/local.mjs dev",
    "build": "node scripts/prepare-next.mjs && node scripts/local.mjs build && pnpm run classes",
    "preview": "node scripts/local.mjs preview",
    "test": "pnpm run test:design-system && pnpm run test:unit && pnpm run boundaries && pnpm run typecheck:ts && pnpm run build && pnpm run test:content && node test/runtime-http.mjs && node packages/l8/web/src/routes/interact.test.mjs && node 'packages/l8/web/src/routes/recipes/$slug/recipe-pages.test.mjs' && pnpm run test:storybook",
    "test:unit": "node --test packages/l8/web/src/lib/seo.test.ts packages/l4/content-build/src/parse.test.mjs packages/l2/recipe-domain/src/formula.test.ts packages/l2/recipe-domain/src/sourdough-process.test.ts packages/l5/ui-primitives/src/primitives/number-field-format.test.ts scripts/deploy-manifest.test.mjs packages/l4/content-build/src/build-content.test.ts packages/l3/api-static/src/generated.test.ts scripts/check-layer-imports.test.mjs scripts/app-build-config.test.mjs test/static-server.test.mjs test/content-media.test.mjs scripts/check-classes.test.mjs test/block-storage.test.ts test/content-source.test.mjs",
    "test:seo": "node test/runtime-http.mjs",
    "test:a11y": "node packages/l8/web/src/routes/accessibility.test.mjs",
    "test:lighthouse": "node test/performance.mjs",
    "shots": "node test/shots.mjs",
    "parity": "node test/parity.mjs",
    "storybook": "pnpm run content && storybook dev -c packages/l8/web/.storybook -p 6006 --host 127.0.0.1",
    "build-storybook": "pnpm run content && storybook build -c packages/l8/web/.storybook -o storybook-static",
    "test:storybook": "pnpm run build-storybook && node packages/l8/web/src/storybook/stories.test.mjs",
    "test:recipe-pages": "pnpm run build && node 'packages/l8/web/src/routes/recipes/$slug/recipe-pages.test.mjs'",
    "convert": "node scripts/convert-fixtures.mjs",
    "classes": "node scripts/check-classes.mjs",
    "boundaries": "node scripts/check-layer-imports.mjs",
    "serve": "node scripts/local.mjs start",
    "deploy": "node scripts/deploy.mjs",
    "verify:prod": "node test/verify-prod.mjs",
    "typecheck": "pnpm run boundaries && pnpm run typecheck:ts",
    "typecheck:ts": "tsc -b --pretty false",
    "nx": "nx",
    "test:design-system": "node scripts/check-design-system.mjs && node --test scripts/check-design-system.test.mjs",
    "test:security": "pnpm audit --audit-level=moderate",
    "local:setup": "node scripts/local.mjs setup",
    "owner:bootstrap": "tsx scripts/content-cli.ts owner",
    "owner:recover": "tsx scripts/content-cli.ts recover",
    "content:plan": "tsx scripts/content-cli.ts plan",
    "content:sync": "tsx scripts/content-cli.ts sync",
    "db:migrate": "tsx scripts/content-cli.ts migrate",
    "generate:importmap": "tsx scripts/generate-import-map.ts",
    "build:worker": "pnpm run build && node scripts/local.mjs worker",
    "test:content": "tsx test/content-integration.ts",
    "test:images": "node test/image-delivery.mjs"
  },
  "dependencies": {
    "@eat-yeet/l0-foundation": "workspace:*",
    "@eat-yeet/l1-api-model": "workspace:*",
    "@eat-yeet/l1-article-model": "workspace:*",
    "@eat-yeet/l1-recipe-model": "workspace:*",
    "@eat-yeet/l2-recipe-domain": "workspace:*",
    "@eat-yeet/l3-api-contract": "workspace:*",
    "@eat-yeet/l3-api-query": "workspace:*",
    "@eat-yeet/l3-api-static": "workspace:*",
    "@eat-yeet/l4-content-build": "workspace:*",
    "@eat-yeet/l4-content-cms": "workspace:*",
    "@eat-yeet/l4-content-model": "workspace:*",
    "@eat-yeet/l5-ui-primitives": "workspace:*",
    "@eat-yeet/l6-ui-catalog": "workspace:*",
    "@eat-yeet/l6-ui-content-blocks": "workspace:*",
    "@eat-yeet/l6-ui-shell": "workspace:*",
    "@eat-yeet/l7-home": "workspace:*",
    "@eat-yeet/l7-learn": "workspace:*",
    "@eat-yeet/l7-recipes": "workspace:*",
    "@eat-yeet/l7-search": "workspace:*",
    "@opennextjs/cloudflare": "1.20.6",
    "@payloadcms/db-d1-sqlite": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/storage-r2": "3.89.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.5",
    "payload": "3.89.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "chrome-launcher": "^1.2.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.2",
    "lighthouse": "^13.4.1",
    "marked": "^14.1.3",
    "nx": "^23.1.1",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "shadcn": "^4.19.0",
    "storybook": "^10.5.8",
    "subset-font": "2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "wrangler": "4.131.1"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "qs@>=2.2.5 <6.16.0": "6.16.0",
      "hono@<4.13.5": "4.13.5",
      "smol-toml@<=1.7.0": "1.7.1",
      "esbuild@<=0.24.2": "0.25.12",
      "dompurify@<=3.4.12": "3.4.13"
    }
  }
}
